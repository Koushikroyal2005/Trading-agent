MODE=PAPER_TRADING
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DATABASE_URL=sqlite+aiosqlite:///./backend/data/vector.db
REDIS_URL=redis://localhost:6379/0
HDD_STORAGE_PATH=./backend/data
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_SYNTHETIC_DATA=true
SCHEDULED_SYMBOLS=AAPL,MSFT,SPY
SCHEDULED_TIMEFRAMES=15
CYCLE_SCHEDULE_SECONDS=300
MARKET_STREAM_INTERVAL_SECONDS=60
