MODE=PAPER_TRADING
ENVIRONMENT=production
LOG_LEVEL=INFO
API_KEY=replace-with-long-random-value
DATABASE_URL=postgresql+asyncpg://vector:replace-me@timescaledb:5432/vector
TIMESCALE_URL=postgresql://vector:replace-me@timescaledb:5432/vector
REDIS_URL=redis://default:replace-me@redis:6379/0
HDD_STORAGE_PATH=/data
CORS_ORIGINS=https://your-dashboard.example
ALLOW_SYNTHETIC_DATA=false
SCHEDULED_SYMBOLS=AAPL,MSFT,SPY
SCHEDULED_TIMEFRAMES=15
CYCLE_SCHEDULE_SECONDS=300
MARKET_STREAM_INTERVAL_SECONDS=60
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
GEMINI_API_KEY=
