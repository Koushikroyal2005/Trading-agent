MODE=PAPER_TRADING
ENVIRONMENT=development
LOG_LEVEL=INFO

# Keep project data on the existing HDD
HDD_STORAGE_PATH=./backend/data

# PostgreSQL / TimescaleDB
POSTGRES_USER=vector
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=vector

# Used when running Python directly without Docker
DATABASE_URL=sqlite+aiosqlite:///./backend/data/vector.db
TIMESCALE_URL=

# Redis
REDIS_PASSWORD=YOUR_PASSWORD
REDIS_URL=redis://default:YOUR_PASSWORD@localhost:6379/0

# Alpaca paper trading
ALPACA_API_KEY=YOUR_API_KEY
ALPACA_SECRET_KEY=YOUR_SECRET_KEY
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Gemini
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Leave empty during your first local test
API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_POSITION_PERCENTAGE=0.05
MAX_DAILY_LOSS_PERCENTAGE=0.02
AGENT_TIMEOUT_SECONDS=5

# Automation remains analysis-only until enabled through the dashboard/API.
ALLOW_SYNTHETIC_DATA=true
SCHEDULED_SYMBOLS=AAPL,MSFT,SPY
SCHEDULED_TIMEFRAMES=15
CYCLE_SCHEDULE_SECONDS=300
MARKET_STREAM_INTERVAL_SECONDS=60
MARKET_DATA_MAX_AGE_MINUTES=20
EVENT_STREAM_MAX_LENGTH=50000
